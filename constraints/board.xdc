set_property PACKAGE_PIN AE5 [get_ports pl_clk_p]
set_property PACKAGE_PIN AF5 [get_ports pl_clk_n]
set_property IOSTANDARD LVDS [get_ports {pl_clk_p pl_clk_n}]
set_property DIFF_TERM_ADV TERM_NONE [get_ports {pl_clk_p pl_clk_n}]
set_property PACKAGE_PIN F13 [get_ports camera_scl]
set_property PACKAGE_PIN E13 [get_ports camera_sda]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_scl camera_sda}]
set_property PACKAGE_PIN W8 [get_ports mipi_clk_p]
set_property PACKAGE_PIN Y8 [get_ports mipi_clk_n]
set_property PACKAGE_PIN U9 [get_ports {mipi_data_p[0]}]
set_property PACKAGE_PIN V9 [get_ports {mipi_data_n[0]}]
set_property PACKAGE_PIN U8 [get_ports {mipi_data_p[1]}]
set_property PACKAGE_PIN V8 [get_ports {mipi_data_n[1]}]
set_false_path -to [get_cells -hier -filter {NAME =~ *gc1_reg*}]
